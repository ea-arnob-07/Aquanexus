layout(location=0) in vec3 aPos;
layout(location=1) in vec3 aNormal;
layout(location=2) in vec2 aUV;
uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProj;
uniform float uTime;
uniform float uFlowStrength;
uniform vec3 uOutletA;
uniform vec3 uOutletB;
uniform float uOutletStrengthA;
uniform float uOutletStrengthB;
out vec3 vWorldPos;
out vec3 vNormal;
out vec2 vUV;
void main(){
    vec4 wp=uModel*vec4(aPos,1.0); vec2 xz=wp.xz; float t=uTime;
    float a1=0.036+0.018*uFlowStrength, a2=0.024+0.010*uFlowStrength, a3=0.012, a4=0.006;
    float p1=dot(xz,normalize(vec2(1.0,0.42)))*1.25+t*1.15;
    float p2=dot(xz,normalize(vec2(-0.52,1.0)))*1.83+t*0.84+1.9;
    float p3=dot(xz,normalize(vec2(0.73,-1.0)))*3.35+t*1.63+0.4;
    float p4=dot(xz,normalize(vec2(1.0,0.84)))*7.5+t*2.25;
    float h=a1*sin(p1)+a2*sin(p2)+a3*sin(p3)+a4*sin(p4);
    vec2 d=vec2(0.0);
    d += a1*cos(p1)*normalize(vec2(1.0,0.42))*1.25;
    d += a2*cos(p2)*normalize(vec2(-0.52,1.0))*1.83;
    d += a3*cos(p3)*normalize(vec2(0.73,-1.0))*3.35;
    d += a4*cos(p4)*normalize(vec2(1.0,0.84))*7.5;
    float ra=length(xz-uOutletA.xz), rb=length(xz-uOutletB.xz);
    float rippleA=sin(ra*14.0-t*8.0)*exp(-ra*0.62)*0.045*uOutletStrengthA;
    float rippleB=sin(rb*14.0-t*8.0)*exp(-rb*0.62)*0.045*uOutletStrengthB;
    h+=rippleA+rippleB;
    float da=cos(ra*14.0-t*8.0)*14.0*exp(-ra*0.62)-0.62*sin(ra*14.0-t*8.0)*exp(-ra*0.62);
    float db=cos(rb*14.0-t*8.0)*14.0*exp(-rb*0.62)-0.62*sin(rb*14.0-t*8.0)*exp(-rb*0.62);
    if(ra>0.01) d += normalize(xz-uOutletA.xz)*da*0.045*uOutletStrengthA;
    if(rb>0.01) d += normalize(xz-uOutletB.xz)*db*0.045*uOutletStrengthB;
    wp.y+=h; vWorldPos=wp.xyz; vNormal=normalize(vec3(-d.x,1.0,-d.y)); vUV=aUV;
    gl_Position=uProj*uView*wp;
}
